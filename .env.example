NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Server-only. Never prefix this key with NEXT_PUBLIC_ or commit its value.
SUPABASE_SERVICE_ROLE_KEY=your_rotated_service_role_key

# Optional: enable the client email action only after its server settings are configured.
NEXT_PUBLIC_LAB_EMAIL_ENABLED=false
# Enable only when the Laboratory migration is installed in this environment.
NEXT_PUBLIC_LAB_DATABASE_ENABLED=false
# Server-only laboratory email settings. Use a verified sender domain.
RESEND_API_KEY=your_resend_api_key
LAB_REPORT_FROM_EMAIL=Hayked Laboratory <laboratory@example.com>
